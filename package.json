{
  "name": "@ebarooni/angular-eslint-config",
  "version": "2.0.0",
  "description": "Shared ESLint configuration for Angular projects",
  "keywords": [
    "angular",
    "eslint",
    "eslint-config"
  ],
  "homepage": "https://github.com/ebarooni/angular-eslint-config#readme",
  "bugs": {
    "url": "https://github.com/ebarooni/angular-eslint-config/issues"
  },
  "license": "MIT",
  "author": "Ehsan Barooni",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebarooni/angular-eslint-config.git"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/index.js dist/index.js",
    "format": "npm run prettier -- . --write",
    "format:check": "npm run prettier -- . --check",
    "prepublishOnly": "npm ci && npm run format:check && npm run build && npm run test",
    "prettier": "npx prettier",
    "test": "npm run build && npm run test:install && npm run test:lint",
    "test:install": "cd test && npm ci",
    "test:lint": "node scripts/check-fixture-config.mjs && cd test && npx eslint"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "typescript": ">=6.0.0 <6.1.0"
  },
  "peerDependencies": {
    "@eslint/js": "^10.0.0",
    "angular-eslint": "^22.0.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "typescript": ">=6.0.0 <6.1.0",
    "typescript-eslint": "^8.58.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
