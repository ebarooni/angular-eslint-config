{
  "name": "@ebarooni/angular-eslint-config",
  "version": "1.1.0",
  "description": "Shared ESLint configuration for Angular projects",
  "keywords": [
    "angular",
    "eslint",
    "eslint-config"
  ],
  "homepage": "https://github.com/ebarooni/angular-eslint-config#readme",
  "bugs": {
    "url": "https://github.com/ebarooni/angular-eslint-config/issues"
  },
  "license": "MIT",
  "author": "Ehsan Barooni <mail@barooni.dev> (https://barooni.dev/)",
  "files": [
    "dist"
  ],
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebarooni/angular-eslint-config.git"
  },
  "scripts": {
    "build": "npm run rollup -- -c rollup.config.js && cp src/index.js dist/index.js",
    "eslint": "npx eslint",
    "fmt": "npm run prettier -- . --write",
    "lint": "npm run prettier -- . --check",
    "prepublishOnly": "npm i && npm run lint && npm run test && npm run build",
    "prettier": "npx prettier",
    "rollup": "npx rollup",
    "test": "cd test && npm i && npx eslint"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "rollup": "^4.54.0"
  },
  "peerDependencies": {
    "angular-eslint": ">=18.0.0 <22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "typescript": ">=4.8.4 <6.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
